# Maintainer: MaterialLauncher <https://github.com/valdr1210/MaterialLauncherV2>
pkgname=material-launcher-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="Minecraft Launcher in Material Design 3 (Material You)"
arch=('x86_64')
url="https://github.com/valdr1210/MaterialLauncherV2"
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'libnotify')
provides=('material-launcher')
conflicts=('material-launcher')
source=("https://github.com/valdr1210/MaterialLauncherV2/releases/download/v${pkgver}/Material_Launcher_${pkgver}_amd64.deb")
sha256sums=('2f4c52e99b2989b82b7df16de3a3a8ae299f99d07298f5fb880d08cc5109b2b2')

package() {
    tar -xf data.tar.xz -C "${pkgdir}"
    install -dm755 "${pkgdir}/usr/bin"
    ln -sf "/opt/Material Launcher/material-launcher" "${pkgdir}/usr/bin/material-launcher"
}
