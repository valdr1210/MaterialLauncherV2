{
  "name": "materiallauncherv2",
  "desktopName": "material-launcher",
  "version": "1.1.0",
  "description": "Material Launcher in Material Design 3",
  "homepage": "https://github.com/valdr1210/MaterialLauncherV2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:all": "electron-builder -w -l",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win portable",
    "build:win:nsis": "electron-builder --win nsis",
    "build:win:msi": "electron-builder --win msi",
    "build:win:zip": "electron-builder --win zip",
    "build:linux": "electron-builder --linux",
    "build:linux:appimage": "electron-builder --linux AppImage",
    "build:linux:deb": "electron-builder --linux deb",
    "build:linux:rpm": "electron-builder --linux rpm",
    "build:linux:flatpak": "electron-builder --linux flatpak",
    "build:linux:tar": "electron-builder --linux tar.gz",
    "build:linux:zip": "electron-builder --linux zip"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "material-design-3",
    "electron"
  ],
  "author": "MaterialLauncher",
  "license": "MIT",
  "build": {
    "appId": "com.materiallauncher.app",
    "productName": "Material Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "src/assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "launcherCore.js",
      "authManager.js",
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico",
      "artifactName": "${productName}-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Material Launcher",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "msi": {
      "oneClick": false,
      "runAfterFinish": false,
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "flatpak",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png",
      "category": "Game",
      "maintainer": "MaterialLauncher",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-linux.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "deb": {
      "category": "Game",
      "packageCategory": "games",
      "priority": "optional",
      "artifactName": "${productName}_${version}_${arch}.${ext}"
    },
    "rpm": {
      "category": "Game",
      "packageCategory": "Amusements/Games",
      "artifactName": "${productName}-${version}.${arch}.${ext}"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "23.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "23.08",
      "category": "Game",
      "artifactName": "${productName}-${version}.${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.21.1",
    "minecraft-launcher-core": "^3.18.2"
  }
}
